# Ambiente
AUTOGESTOR_APP_ENV=development

# Banco de dados
# Desenvolvimento local (sem DATABASE_URL): usa fallback SQLite automaticamente.
# Producao/Vercel: DATABASE_URL e obrigatoria e deve ser PostgreSQL.
# Exemplos:
# DATABASE_URL=sqlite:///autogestor.db
# DATABASE_URL=postgresql://user:password@host:5432/autogestor
DATABASE_URL=

# Opcional: desabilita fallback SQLite em dev para forcar configuracao explicita.
AUTOGESTOR_ALLOW_SQLITE_FALLBACK=true

# JWT
AUTOGESTOR_SECRET_KEY=troque-esta-chave-por-um-segredo-forte
AUTOGESTOR_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS (separar multiplas origens por virgula)
AUTOGESTOR_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
